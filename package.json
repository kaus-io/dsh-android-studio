{
  "name": "@local/dsh-android-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Android Studio for DSH: the resident Android workbench (ADB, run/build/sign, task output) plus an IDE-grade code reader for Sidebar document previews",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "runner.js",
    "android.js",
    "client.js",
    "client.view.js",
    "ui-model.js",
    "build-client.mjs",
    "tsconfig.json",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "AGENTS.md"
  ],
  "scripts": {
    "build:client": "node build-client.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node build-client.mjs --check && node --test *.test.js tests/*.test.mjs",
    "smoke": "node smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
